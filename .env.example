# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email via Resend (optional — logs to console if absent)
RESEND_API_KEY=
EMAIL_FROM=noreply@interestmatcher.app

# Rate limiting via Upstash Redis (optional — uses in-memory limiter if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring via Sentry (optional)
SENTRY_DSN=

# Analytics via Plausible (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Webhook shared secret (for DB webhook → email notifications)
WEBHOOK_SECRET=

# Legal document versioning
TERMS_VERSION=2026-04
PRIVACY_VERSION=2026-04

# Age gate (minimum age to register)
MIN_AGE=16

# Public env vars for client-side
NEXT_PUBLIC_MIN_AGE=16
